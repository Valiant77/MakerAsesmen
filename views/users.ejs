<!DOCTYPE html>
<html>
<head>
  <title>Users Table</title>
</head>
<body>
  <h1>Pengguna</h1>
  <a href="/users/create"><button>+ Tambah Pengguna Baru</button></a>
  <table border="1">
    <tr>
      <th>#</th>
      <th>Nama</th>
      <th>Username</th>
      <th>Email</th>
      <th>No Telepon</th>
      <th>Aksi</th>
    </tr>

    <% users.forEach(user => { %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.name %></td>
        <td><%= user.username %></td>
        <td><%= user.email %></td>
        <td><%= user.no_telp %></td>
        <td>
            <button>Detail</button>
            <a href="/users/edit/<%= user.id %>"><button>Edit</button></a>
            <a href="/users/delete/<%= user.id %>" onclick="return confirm('Delete this user???')"><button>Hapus</button></a>
        </td>
      </tr>
    <% }) %>
  </table>

  <script>
  document.querySelectorAll('.delete-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const id = this.dataset.id;
      if (confirm('Delete this user???')) {
        window.location.href = `/users/delete/${id}`;
      }
    });
  });
</script>
</body>
</html>
